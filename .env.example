# Supabase Auth. Copy this file to .env.local and restart python3 server.py.
# These two public settings are loaded at runtime; no frontend rebuild is required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never use a secret or service_role key. Publishable (sb_publishable_...) or legacy anon only.

# Optional wallet + Base Sepolia integrations require npm run build after changes.
VITE_DYNAMIC_ENVIRONMENT_ID=
VITE_RPC_URL=https://sepolia.base.org
VITE_RESOURCE_TRACKER_ADDRESS=
VITE_ESCROW_ADDRESS=
# Backend-only credentials; never prefix secrets with VITE_
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
